{
	"name": "@com.mgmtp.a12.antlrcodeeditor/code-editor-in-bap-example",
	"version": "6.2.4",
	"description": "Business Application Platform with Anltr4 Code Editor",
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "run-s clean initialize compile write-build-info bundle",
		"build:prod": "cross-env NODE_ENV=prod npm run build",
		"bundle": "webpack --config ./webpack.config.js",
		"bundle:watch": "webpack serve --config ./webpack.config.js",
		"clean": "rimraf --glob ./target ./dist ./platform-server.log*",
		"initialize": "npm-run-all --aggregate-output --continue-on-error --parallel initialize:**",
		"initialize:output": "mkdirp ./target ./dist",
		"precompile": "npm run antlrBuildTool",
		"compile": "npm-run-all --aggregate-output --continue-on-error --parallel compile:**",
		"compile:typescript": "npm run typescript -- --project ./src",
		"start": "run-s write-build-info start:watch",
		"start:watch": "run-p bundle:watch",
		"typescript": "tsc",
		"antlrBuildTool": "antlr4-buildtool runBuildTool --config=AntlrBuildToolConfig.json",
		"write-build-info": "node ./scripts/write-build-info.js"
	},
	"devDependencies": {
