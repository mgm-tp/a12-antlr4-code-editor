{
	"name": "antlr4-code-editor",
	"private": true,
	"type": "module",
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"scripts": {
		"bootstrap": "pnpm install",
		"clean": "lerna run clean",
		"build": "lerna run build",
		"compile": "lerna run compile",
		"start": "run-s compile start:watch",
		"start:watch": "lerna run start --stream --parallel",
		"publish": "lerna publish --no-git-tag-version --no-push --no-git-reset --force-publish --yes",
		"postinstall": "lerna run prepare-lib",
		"test": "run-p test:**",
		"test:check": "lerna run test",
		"test:lint": "pnpm lint",
		"lint": "run-p lint:**",
		"lint:eslint": "eslint .",
		"lint:prettier": "prettier --check \"**/*.{js,ts,tsx}\"",
		"upgrade-a12": "node ./upgrade-version-scripts/upgrade-a12.js",
		"upgrade-a12-peers": "node ./upgrade-version-scripts/upgrade-a12.js --upgrade-peers",
		"prepare": "husky"
	},
	"devDependencies": {
		"@com.mgmtp.a12.devtools/eslint-config": "3.1.1",
		"@com.mgmtp.a12.devtools/prettier-config": "1.1.1",
		"@types/eslint": "^9.6.1",
		"eslint": "9.39.5",
		"eslint-parser-plain": "^0.1.1",
		"eslint-plugin-jsdoc": "62.9.0",
		"eslint-plugin-lodash": "8.0.0",
		"eslint-plugin-notice": "1.0.0",
		"glob": "13.0.6",
		"husky": "9.1.7",
		"lerna": "10.1.0",
		"lint-staged": "10.2.11",
		"npm-run-all2": "9.0.3",
		"prettier": "3.9.6",
		"typescript": "6.0.2",
		"typescript-eslint": "^8.62.1"
	},
	"lint-staged": {
		"*.{ts,tsx,js}": [
			"prettier --write",
			"eslint --fix"
		]
	}
}
