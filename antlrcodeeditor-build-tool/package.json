{
	"name": "@com.mgmtp.a12.antlrcodeeditor/antlrcodeeditor-build-tool",
	"version": "6.2.4",
	"description": "Antlr Code Editor Build Tool for generating Lexer and Parser file and theming file",
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"files": [
		"src",
		"build.gradle",
		"settings.gradle",
		"tsconfig.json",
		"cyclonedx.json",
		"licenses",
		"LICENSE",
		"NOTICE",
		"THIRD_PARTY_NOTICES"
	],
	"bin": {
		"antlr4-buildtool": "src/cli.js"
	},
	"scripts": {
		"clean": "rimraf --glob ./gen ./target ./*.tgz",
		"theming": "node --loader ts-node/esm ./src/theming.ts",
		"test": "vitest run",
		"generateSBOM": "cyclonedx-npm --ignore-npm-errors --output-file cyclonedx.json"
	},
	"type": "module",
	"devDependencies": {
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@com.mgmtp.a12.devtools/tsconfig": "1.1.0",
		"antlr4": "4.13.2",
		"rimraf": "6.1.3",
		"ts-node": "10.9.2",
		"yargs": "15.4.1"
	}
}
